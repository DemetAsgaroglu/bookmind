# gemini veya ollama
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Ana model 429/503/504 verirse sirayla denenecek modeller, virgulle (bos birakilirsa yedek yok)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# 503 gibi gecici hatalarda model basina toplam deneme sayisi
GEMINI_MAX_ATTEMPTS=2
# Istek basina sure siniri (saniye)
GEMINI_TIMEOUT=90

# Yerel model icin: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_AGENT_STEPS=6
HISTORY_LIMIT=12

# Sadece fetch_books.py icin gerekli
GOOGLE_BOOKS_API_KEY=
